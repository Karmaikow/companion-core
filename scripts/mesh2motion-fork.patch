@@ -0,0 +1,243 @@
+/**
+ * Companion Core: encaixe automático dos esqueletos de bicho do Mesh2Motion (raposa/cachorro, cavalo, aranha, pássaro,
+ * dragão, kaiju, cobra, tubarão). O molde vem com o modelo dele (models/model-<tipo>.glb), então a mesma régua mede os
+ * dois: caixa, patas no chão (cada pata é uma mancha no corte rente ao chão) e a barriga (onde as patas se juntam ao
+ * corpo). As juntas vão do modelo do molde para o modelo novo por esses pontos (eixo por eixo, em trechos retos), cada
+ * pata vai até a mancha dela, e depois cada junta é centralizada dentro da malha nos eixos de lado ao osso (osso
+ * comprido segue o corpo, só se ajeita na grossura). Lados esquerdo e direito ficam espelhados.
+ * Só mexe nas posições das juntas (como o editor manual); as rotações do molde ficam.
+ */
+import { Box3, Object3D, Vector3 } from 'three'
+import { cut, triangles } from './CompanionCoreAutoFit'
+
+type P = Float32Array
+interface Blob2 { x: number, z: number, n: number }
+interface Measure { box: Box3, feet: Blob2[], belly: number | null }
+
+/** Manchas ligadas de um corte horizontal (pontos dos segmentos numa grade, juntados por vizinhança). */
+function blobs (seg: number[], cell: number): Blob2[] {
+  const grid = new Map<string, [number, number]>()
+  for (let i = 0; i < seg.length; i += 4) {
+    const x0 = seg[i], z0 = seg[i + 1], x1 = seg[i + 2], z1 = seg[i + 3]
+    const steps = Math.max(1, Math.ceil(Math.hypot(x1 - x0, z1 - z0) / (cell * 0.5)))
+    for (let s = 0; s <= steps; s++) {
+      const x = x0 + (x1 - x0) * s / steps, z = z0 + (z1 - z0) * s / steps
+      grid.set(Math.floor(x / cell) + ',' + Math.floor(z / cell), [x, z])
+    }
+  }
+  const seen = new Set<string>()
+  const out: Blob2[] = []
+  for (const key of grid.keys()) {
+    if (seen.has(key)) continue
+    const stack = [key]; seen.add(key)
+    let sx = 0, sz = 0, n = 0
+    while (stack.length > 0) {
+      const k = stack.pop() as string
+      const [x, z] = grid.get(k) as [number, number]
+      sx += x; sz += z; n++
+      const [i, j] = k.split(',').map(Number)
+      for (let di = -1; di <= 1; di++) for (let dj = -1; dj <= 1; dj++) {
+        const nk = (i + di) + ',' + (j + dj)
+        if (!seen.has(nk) && grid.has(nk)) { seen.add(nk); stack.push(nk) }
+      }
+    }
+    out.push({ x: sx / n, z: sz / n, n })
+  }
+  return out
+}
+
+function measure (tri: P, box: Box3, with_feet: boolean): Measure {
+  const H = box.max.y - box.min.y
+  const size = box.getSize(new Vector3())
+  const cell = 0.012 * Math.max(size.x, size.z, H)
+  if (!with_feet) return { box, feet: [], belly: null }
+  const ground = box.min.y + 0.03 * H
+  let feet = blobs(cut(tri, ground), cell)
+  const big = Math.max(0, ...feet.map((f) => f.n))
+  feet = feet.filter((f) => f.n >= big * 0.15)
+  // barriga: subindo, a primeira altura em que tudo vira uma mancha só (e continua assim)
+  let belly: number | null = null
+  let run = 0
+  for (let y = ground; y < box.min.y + 0.8 * H; y += 0.01 * H) {
+    const bs = blobs(cut(tri, y), cell).filter((b) => b.n >= 3)
+    if (bs.length === 1) { if (++run >= 3) { belly = y - 0.02 * H; break } } else run = 0
+  }
+  return { box, feet, belly }
+}
+
+/** Mapa em trechos retos (pares origem → destino, em ordem). */
+function piecewise (pairs: Array<[number, number]>): (v: number) => number {
+  const ps = pairs.slice().sort((a, b) => a[0] - b[0])
+  const clean: Array<[number, number]> = []
+  for (const p of ps) { const l = clean[clean.length - 1]; if (l === undefined || (p[0] - l[0] > 1e-6 && p[1] - l[1] > 1e-6)) clean.push(p) }

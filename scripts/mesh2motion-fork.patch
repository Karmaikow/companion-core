+    const used_tip = new Set<Object3D>(), used_foot = new Set<Blob2>()
+    // a mancha é o pé inteiro; a ponta fica à frente do centro dele como no molde
+    for (const pr of pairs) {
+      if (used_tip.has(pr.tip) || used_foot.has(pr.foot) || pr.d > 0.35 * Math.max(H, box.max.z - box.min.z)) continue
+      used_tip.add(pr.tip); used_foot.add(pr.foot); report.matched++
+      // a corrente da pata: da ponta subindo enquanto o pai só tem esse filho
+      const chain: Object3D[] = [pr.tip]
+      let c = pr.tip
+      while (c.parent !== null && c.parent.type === 'Bone' && kids(c.parent).length === 1 && c.parent.parent?.type === 'Bone') { c = c.parent; chain.push(c) }
+      // o pé do molde (média da corrente perto do chão) vai para o centro da mancha
+      const low = chain.filter((b) => (tpl.get(b) as Vector3).y < tbox.min.y + 0.15 * tH)
+      const foot = (low.length > 0 ? low : [pr.tip]).reduce((a, b) => a.add(pos.get(b) as Vector3), new Vector3()).divideScalar(Math.max(1, low.length))
+      const dx = pr.foot.x - foot.x, dz = pr.foot.z - foot.z
+      const n = chain.length
+      chain.forEach((b, i) => {
+        const wgt = n <= 1 ? 1 : Math.min(1, 1.4 * (n - 1 - i) / (n - 1))
+        const p = pos.get(b) as Vector3; p.x += dx * wgt; p.z += dz * wgt
+      })
+    }
+  }
+
+  // ---- cada junta no meio da grossura, nos eixos de lado ao osso (pontas ficam onde estão: são as extremidades)
+  const gap = 0.6 * Math.max(H, box.max.x - box.min.x, box.max.z - box.min.z)
+  for (let pass = 0; pass < 2; pass++) {
+    for (const b of bones) {
+      const ks = kids(b)
+      if (ks.length === 0 || b.parent === null || b.parent.type !== 'Bone') continue
+      const p = pos.get(b) as Vector3
+      // direção do osso: do pai para a junta e da junta para os filhos
+      const dir = new Vector3()
+      dir.add(p.clone().sub(pos.get(b.parent) as Vector3))
+      for (const k of ks) dir.add((pos.get(k) as Vector3).clone().sub(p).divideScalar(ks.length))
+      if (dir.lengthSq() < 1e-12) continue
+      dir.normalize()
+      const mid = Math.abs((tpl.get(b) as Vector3).x - tcx) < 0.01 * tH
+      for (const axis of [0, 1, 2] as const) {
+        if (Math.abs(dir.getComponent(axis)) > 0.55) continue // ao longo do osso: não mexe
+        if (axis === 0 && mid) { p.x = cx; continue }
+        const c = center_on(tri, axis, p, gap)
+        if (c !== null) p.setComponent(axis, c)
+      }
+    }
+  }
+
+  // ---- espelha esquerda e direita
+  const byName = new Map(bones.map((b) => [b.name, b]))
+  const done = new Set<Object3D>()
+  for (const b of bones) {
+    const pn = partner(b.name); const o = pn !== null ? byName.get(pn) : undefined
+    if (o === undefined || done.has(b)) continue
+    done.add(b); done.add(o)
+    const a = pos.get(b) as Vector3, c = pos.get(o) as Vector3
+    const avg = new Vector3((a.x + (2 * cx - c.x)) / 2, (a.y + c.y) / 2, (a.z + c.z) / 2)
+    a.copy(avg); c.set(2 * cx - avg.x, avg.y, avg.z)
+  }
+
+  // ---- aplica dos pais para os filhos
+  for (const b of bones) {
+    const t = pos.get(b)
+    if (t === undefined || b.parent === null) continue
+    b.parent.updateWorldMatrix(true, false)
+    b.position.copy(b.parent.worldToLocal(t.clone()))
+    b.updateMatrixWorld(true)
+  }
+  report.ok = true
+  return report
+}

+  return (v: number) => {
+    let i = 0
+    while (i < clean.length - 2 && v > clean[i + 1][0]) i++
+    const [a0, b0] = clean[i], [a1, b1] = clean[i + 1]
+    return b0 + (v - a0) * (b1 - b0) / (a1 - a0)
+  }
+}
+
+/** Níveis de z das patas (frente, trás…): patas a menos de `gap` uma da outra no z são o mesmo nível. */
+function levels (feet: Blob2[], gap: number): number[] {
+  const zs = feet.map((f) => f.z).sort((a, b) => a - b)
+  const out: number[][] = []
+  for (const z of zs) { const l = out[out.length - 1]; if (l !== undefined && z - l[l.length - 1] < gap) l.push(z); else out.push([z]) }
+  return out.map((l) => l.reduce((a, b) => a + b, 0) / l.length)
+}
+
+/** Onde a reta paralela ao eixo `axis` passando por `p` cruza a malha (coordenadas nesse eixo). */
+function line_hits (tri: P, axis: 0 | 1 | 2, p: Vector3): number[] {
+  const u = axis === 0 ? 1 : 0, w = axis === 2 ? 1 : 2
+  const pu = p.getComponent(u), pw = p.getComponent(w)
+  const out: number[] = []
+  for (let i = 0; i < tri.length; i += 9) {
+    const au = tri[i + u], aw = tri[i + w], bu = tri[i + 3 + u], bw = tri[i + 3 + w], cu = tri[i + 6 + u], cw = tri[i + 6 + w]
+    if (pu < Math.min(au, bu, cu) || pu > Math.max(au, bu, cu) || pw < Math.min(aw, bw, cw) || pw > Math.max(aw, bw, cw)) continue
+    const d = (bw - cw) * (au - cu) + (cu - bu) * (aw - cw)
+    if (Math.abs(d) < 1e-12) continue
+    const l1 = ((bw - cw) * (pu - cu) + (cu - bu) * (pw - cw)) / d
+    const l2 = ((cw - aw) * (pu - cu) + (au - cu) * (pw - cw)) / d
+    const l3 = 1 - l1 - l2
+    if (l1 < 0 || l2 < 0 || l3 < 0) continue
+    out.push(l1 * tri[i + axis] + l2 * tri[i + 3 + axis] + l3 * tri[i + 6 + axis])
+  }
+  return out
+}
+
+/** Centro da grossura da malha em volta de `p` no eixo: entre a superfície mais perto de um lado e do outro. */
+function center_on (tri: P, axis: 0 | 1 | 2, p: Vector3, max_gap: number): number | null {
+  const v = p.getComponent(axis)
+  let lo = -Infinity, hi = Infinity
+  for (const h of line_hits(tri, axis, p)) { if (h <= v && h > lo) lo = h; if (h > v && h < hi) hi = h }
+  if (!Number.isFinite(lo) || !Number.isFinite(hi) || hi - lo > max_gap) return null
+  return (lo + hi) / 2
+}
+
+const partner = (name: string): string | null => {
+  const m = /^(.*[_.])([LlRr])$/.exec(name)
+  if (m === null) return null
+  const s = m[2]
+  return m[1] + (s === 'L' ? 'R' : s === 'R' ? 'L' : s === 'l' ? 'r' : 'l')
+}
+
+export interface CreatureFitReport { ok: boolean, type: string, feet_template: number, feet_model: number, belly: number | null, matched: number }
+
+const WITH_FEET = new Set(['fox', 'horse', 'spider', 'bird', 'dragon', 'kaiju'])
+
+export function companion_core_creature_fit (type: string, armature: Object3D, model: Object3D, template_model: Object3D): CreatureFitReport {
+  const with_feet = WITH_FEET.has(type)
+  const tri = triangles(model), ttri = triangles(template_model)
+  const box = new Box3().setFromObject(model), tbox = new Box3().setFromObject(template_model)
+  const H = box.max.y - box.min.y, tH = tbox.max.y - tbox.min.y
+  const report: CreatureFitReport = { ok: false, type, feet_template: 0, feet_model: 0, belly: null, matched: 0 }
+  if (tri.length < 9 * 50 || H <= 0 || tH <= 0) return report
+  const me = measure(tri, box, with_feet), tm = measure(ttri, tbox, with_feet)
+  report.feet_template = tm.feet.length; report.feet_model = me.feet.length
+  report.belly = me.belly !== null ? (me.belly - box.min.y) / H : null
+  const cx = (box.min.x + box.max.x) / 2, tcx = (tbox.min.x + tbox.max.x) / 2
+  const feet_ok = with_feet && me.feet.length >= 2 && tm.feet.length >= 2
+
+  // ---- mapa do molde para o modelo, eixo por eixo
+  const xp: Array<[number, number]> = [[tbox.min.x, box.min.x], [tcx, cx], [tbox.max.x, box.max.x]]
+  const yp: Array<[number, number]> = [[tbox.min.y, box.min.y], [tbox.max.y, box.max.y]]
+  const zp: Array<[number, number]> = [[tbox.min.z, box.min.z], [tbox.max.z, box.max.z]]
+  if (feet_ok) {
+    const fx = (fs: Blob2[], c: number): number => fs.reduce((a, f) => a + Math.abs(f.x - c), 0) / fs.length
+    const a = fx(tm.feet, tcx), b = fx(me.feet, cx)
+    if (a > 0.02 * tH && b > 0.02 * H) xp.push([tcx - a, cx - b], [tcx + a, cx + b])
+    const tl = levels(tm.feet, 0.12 * (tbox.max.z - tbox.min.z)), ml = levels(me.feet, 0.12 * (box.max.z - box.min.z))
+    if (tl.length === ml.length) tl.forEach((z, i) => zp.push([z, ml[i]]))
+    else if (tl.length >= 2 && ml.length >= 2) zp.push([tl[0], ml[0]], [tl[tl.length - 1], ml[ml.length - 1]])
+    if (tm.belly !== null && me.belly !== null) yp.push([tm.belly, me.belly])
+  }
+  const mx = piecewise(xp), my = piecewise(yp), mz = piecewise(zp)
+
+  armature.updateWorldMatrix(true, true)
+  const bones: Object3D[] = []
+  armature.traverse((o) => { if (o.type === 'Bone') bones.push(o) })
+  const tpl = new Map<Object3D, Vector3>()
+  const pos = new Map<Object3D, Vector3>()
+  for (const b of bones) {
+    const w = b.getWorldPosition(new Vector3())
+    tpl.set(b, w)
+    pos.set(b, new Vector3(mx(w.x), my(w.y), mz(w.z)))
+  }
+  const kids = (b: Object3D): Object3D[] => b.children.filter((c) => c.type === 'Bone')

+// ---------------------------------------------------------------------------------------------------------------
+// Companion Core: esqueleto salvo ("?esqueleto=<url>&tipo=human&caixa=minX,minY,minZ,maxX,maxY,maxZ")
+
+interface CompanionCorePreset { url: string, box: number[] }
+
+function companion_core_preset (type: SkeletonType): CompanionCorePreset | null {
+  const q = new URLSearchParams(location.search)
+  const url = q.get('esqueleto')
+  const box = (q.get('caixa') ?? '').split(',').map(Number)
+  if (url === null || box.length !== 6 || box.some((n) => !Number.isFinite(n))) return null
+  if ((q.get('tipo') ?? 'human') !== type) return null
+  return { url, box }
+}
+
+/**
+ * Os ossos do modelo salvo (que podem estar dentro da malha), num "Armature" novo, esticados da caixa do modelo
+ * salvo para a caixa do modelo aberto agora: mesma altura e o pé no mesmo lugar.
+ */
+function preset_armature (scene: Object3D, box: number[]): Object3D | null {
+  // o arquivo guarda os ossos na pose em que estavam ao exportar (a animação tocando): volta à pose de encaixe
+  scene.traverse((o) => { if ((o as SkinnedMesh).isSkinnedMesh) (o as SkinnedMesh).skeleton.pose() })
+  scene.updateMatrixWorld(true)
+  let first: Object3D | null = null
+  scene.traverse((o) => { if (first === null && o.type === 'Bone') first = o })
+  if (first === null) return null
+  const root = first as Object3D
+  const armature = new Object3D()
+  if (root.parent !== null) root.parent.matrixWorld.decompose(armature.position, armature.quaternion, armature.scale)
+  armature.add(root.clone(true))
+  // caixa do modelo aberto agora (o que está na cena, sem o esqueleto)
+  const get_box = (window as unknown as { __cc_model_box?: () => Box3 | null }).__cc_model_box
+  const now = get_box?.() ?? null
+  if (now !== null && !now.isEmpty()) {
+    const old_min = new Vector3(box[0], box[1], box[2]), old_max = new Vector3(box[3], box[4], box[5])
+    const old_h = Math.max(1e-6, old_max.y - old_min.y), new_h = Math.max(1e-6, now.max.y - now.min.y)
+    const k = new_h / old_h
+    // pé do centro da caixa antiga → pé do centro da caixa nova
+    const old_foot = new Vector3((old_min.x + old_max.x) / 2, old_min.y, (old_min.z + old_max.z) / 2)
+    const new_foot = new Vector3((now.min.x + now.max.x) / 2, now.min.y, (now.min.z + now.max.z) / 2)
+    const wrap = new Object3D()
+    wrap.add(armature)
+    armature.position.sub(old_foot)
+    wrap.scale.setScalar(k)
+    wrap.position.copy(new_foot)
+    wrap.updateMatrixWorld(true)
+    // achata: um Object3D só com a escala aplicada nas posições dos ossos (como o molde espera)
+    const flat = new Object3D()
+    const m = armature.matrixWorld.clone()
+    m.decompose(flat.position, flat.quaternion, flat.scale)
+    for (const child of [...armature.children]) flat.add(child)
+    const s = flat.scale.x
+    if (Math.abs(s - 1) > 1e-6) {
+      flat.traverse((o) => { if (o !== flat) o.position.multiplyScalar(s) })
+      flat.scale.set(1, 1, 1)
+    }
+    flat.updateMatrixWorld(true)
+    return flat
+  }
+  armature.updateMatrixWorld(true)
+  return armature

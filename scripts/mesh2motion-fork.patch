+    const tips = bones.filter((b) => kids(b).length === 0 && (tpl.get(b) as Vector3).y < tbox.min.y + 0.06 * tH)
+    const free = me.feet.slice()
+    // as pontas mais "certas" primeiro (a mais perto de uma mancha)
+    const pairs: Array<{ tip: Object3D, foot: Blob2, d: number }> = []
+    for (const t of tips) for (const f of free) { const p = pos.get(t) as Vector3; pairs.push({ tip: t, foot: f, d: Math.hypot(p.x - f.x, p.z - f.z) }) }

{
  "name": "companion-core-mvp",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run web",
    "crystal:migrate": "node scripts/migrate-registry.mjs",
    "precrystal:migrate": "npm run build",
    "crystal:server": "node dist/server/crystal-server.js",
    "precrystal:server": "npm run build",
    "build": "node node_modules/typescript/bin/tsc && node scripts/sync-color-module.mjs",
    "start": "npm run web:start",
    "web": "node node_modules/tsx/dist/cli.mjs src/server/web-server.ts",
    "web:start": "node dist/server/web-server.js",
    "test": "npm run build && node scripts/run-tests.mjs",
    "web:mock": "node scripts/start-mock.mjs",
    "android:start": "node scripts/start-android-preview.mjs",
    "android:check": "node scripts/android-self-check.mjs",
    "preweb:start": "npm run build",
    "preweb:mock": "npm run build",
    "demo": "node dist/demo.js",
    "predemo": "npm run build",
    "demo:dev": "tsx src/demo.ts",
    "vercel:build": "npm run build && node scripts/build-vercel-preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

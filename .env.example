# Public Supabase project configuration for the static web client.
# The publishable key is intended for browser use; never put a secret/service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-project-key

# Optional server-only image generation. Do not use a browser/public prefix.
# Leave unset to use references, imports and the library without generation.
# COMPANION_IMAGE_API_KEY=configure-in-server-or-vercel-secret-settings
# COMPANION_IMAGE_MODEL=gpt-image-2.5-sunburst

# Local Core only: export this variable in the shell before web:start.
# Existing registry sessions need explicit migration; never delete their local state.
# COMPANION_REGISTRY_URL=https://your-project-ref.supabase.co/functions/v1/companion-registry

